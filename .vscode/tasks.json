{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend API",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}/.venv/Scripts/python.exe" },
      "args": ["-m", "uvicorn", "app.main:app", "--reload", "--host", "127.0.0.1", "--port", "8000"],
      "options": { "cwd": "${workspaceFolder}/backend", "env": { "PYTHONUNBUFFERED": "1" } },
      "isBackground": true,
      "problemMatcher": {
        "owner": "python",
        "pattern": { "regexp": "^(.+):(\\d+): (error|warning): (.*)$", "file": 1, "line": 2, "severity": 3, "message": 4 },
        "background": { "activeOnStart": true, "beginsPattern": ".*Started.*", "endsPattern": ".*Application startup complete.*" }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^(.+):(\\d+): (error|warning): (.*)$", "file": 1, "line": 2, "severity": 3, "message": 4 },
        "background": { "activeOnStart": true, "beginsPattern": ".*VITE.*", "endsPattern": ".*Local:.*" }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    { "label": "Start Rubrix", "dependsOn": ["Backend API", "Frontend"], "dependsOrder": "parallel", "group": { "kind": "build", "isDefault": true }, "problemMatcher": [] },
    {
      "label": "Backend tests",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}/.venv/Scripts/python.exe" },
      "args": ["-m", "pytest", "-q"],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
